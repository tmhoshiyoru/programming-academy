---
import type { GameBlocks } from '../lib/game-blocks';

interface Props { blocks: GameBlocks; }
const { blocks } = Astro.props;
const documentSource = `<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; connect-src 'none'; form-action 'none'; base-uri 'none'"><style>${blocks['game-css']}</style></head><body>${blocks['game-html']}<script>${blocks['game-js']}<\/script></body></html>`;
---

<iframe class="game-preview" title="互動小遊戲" sandbox="allow-scripts" data-preview-document={documentSource}></iframe>

<script>
  import { loadSandboxedPreview } from '../lib/sandboxed-preview';

  document.querySelectorAll<HTMLIFrameElement>('.game-preview').forEach((frame) => {
    loadSandboxedPreview(frame, frame.dataset.previewDocument ?? '', import.meta.env.BASE_URL, { autoHeight: true });
  });
</script>
