---
import { countChapterLessons, type CourseTreeNode } from '../lib/course-tree';
interface Props { chapters: CourseTreeNode[]; }
const { chapters } = Astro.props;
---
<ul class="course-cards chapter-cards">
  {chapters.map(chapter => (
    <li>
      <a href={chapter.href}>
        <span class="chapter-card-heading">
          <svg class="chapter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /><path d="M7 12h10M7 16h6" /></svg>
          <strong>{chapter.label}</strong>
        </span>
        <span class="chapter-card-meta">{countChapterLessons(chapter)} 個學習內容<span aria-hidden="true"> →</span></span>
      </a>
    </li>
  ))}
</ul>
