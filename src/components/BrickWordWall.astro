<section class="word-wall" data-brick-word-wall aria-label="小綠綠程式學苑">
  <canvas class="word-wall-canvas" aria-label="小綠綠程式學苑"></canvas>
  <button class="word-wall-trigger" type="button" aria-label="小綠綠程式學苑" aria-expanded="false"></button>
  <div class="game-status" hidden>
    <div class="lives" role="img" aria-label="剩餘 3 條生命"><span></span><span></span><span></span></div>
    <span class="game-score" aria-label="得分">0</span>
