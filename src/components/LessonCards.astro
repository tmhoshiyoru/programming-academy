---
import ContentTypeBadge from './ContentTypeBadge.astro';
import type { CourseTreeNode } from '../lib/course-tree';
interface Props { lessons: CourseTreeNode[]; }
const { lessons } = Astro.props;
---
<ul class="course-cards lesson-cards">
  {lessons.map(lesson => (
    <li>
      <a href={lesson.href} class:list={['lesson-card', `content-kind-${lesson.type}`]}>
        <ContentTypeBadge type={lesson.type!} />
        <strong class="lesson-card-title">{lesson.label}</strong>
        {lesson.summary && <span class="lesson-card-summary">{lesson.summary}</span>}
      </a>
    </li>
  ))}
</ul>
