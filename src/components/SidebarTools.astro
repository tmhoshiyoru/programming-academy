---
import { siteUrl } from '../lib/site-url';

const currentPath = Astro.url.pathname;
const tools = [
  { href: siteUrl('/simulator/'), path: '/simulator/', label: '網頁模擬器', icon: 'simulator' },
  { href: siteUrl('/cpp-debug/'), path: '/cpp-debug/', label: 'C++ Debug 工具', icon: 'debug' },
  { href: siteUrl('/cpp-indent/'), path: '/cpp-indent/', label: 'C++ 自動縮排工具', icon: 'indent' },
];
---

<div class="sidebar-tools">
  <p class="sidebar-tools-heading">小工具</p>
  {tools.map((tool) => (
    <a href={tool.href} aria-current={currentPath === tool.href || currentPath.endsWith(tool.path) ? 'page' : undefined}>
      {tool.icon === 'simulator' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M8 22h8M12 18v4M7 9h10M7 13h5" /></svg>}
      {tool.icon === 'debug' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 6-6 6 6 6m8-12 6 6-6 6M14 4l-4 16" /></svg>}
      {tool.icon === 'indent' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>}
      <span>{tool.label}</span>
    </a>
  ))}
</div>
