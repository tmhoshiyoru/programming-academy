---
import type { CourseTreeNode } from '../lib/course-tree';
import { siteUrl } from '../lib/site-url';
interface Props {
  courseId: string;
  courseTitle: string;
  previous: CourseTreeNode | null;
  next: CourseTreeNode | null;
}
const { courseId, courseTitle, previous, next } = Astro.props;
const links = [
  { lesson: previous, label: '前一節', direction: 'previous' },
  { lesson: next, label: '後一節', direction: 'next' },
];
---
<nav class="lesson-pagination" aria-label="課程前後節導覽">
  {links.map(({ lesson, label, direction }) => (
    <a
      class:list={['lesson-pagination-link', `lesson-pagination-${direction}`]}
      href={lesson?.href ?? siteUrl(`/courses/${courseId}/`)}
      rel={lesson ? (direction === 'previous' ? 'prev' : 'next') : undefined}
      aria-label={`${lesson ? label : '回到課程'}：${lesson?.label ?? courseTitle}`}
    >
      <svg class="pagination-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d={lesson ? (direction === 'previous' ? 'M19 12H5m7-7-7 7 7 7' : 'M5 12h14m-7-7 7 7-7 7') : 'm3 10 9-7 9 7M5 9v12h14V9M9 21v-7h6v7'} />
      </svg>
      <span class="pagination-text">
        <span class="pagination-label">{lesson ? label : '回到課程'}</span>
        <strong>{lesson?.label ?? courseTitle}</strong>
      </span>
    </a>
  ))}
</nav>

<style>
  .lesson-pagination { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.25rem; }
  .lesson-pagination-link { display: flex; align-items: center; gap: .85rem; min-width: 0; padding: 1rem 1.15rem; color: #173d2c; background: #fff; border: 1px solid #b8cbbd; border-radius: .8rem; text-decoration: none; box-shadow: 0 4px 14px #203a2c08; transition: border-color .15s, background-color .15s; }
  .lesson-pagination-link:hover { color: #123d28; background: #f5faf3; border-color: #6d9679; }
  .pagination-arrow { flex: 0 0 auto; width: 1.4rem; height: 1.4rem; }
  .pagination-text { display: flex; flex: 1; flex-direction: column; gap: .25rem; min-width: 0; }
  .pagination-label { color: #516b59; font-size: .8rem; font-weight: 650; }
  .pagination-text strong { font-size: 1rem; line-height: 1.5; overflow-wrap: anywhere; }
  .lesson-pagination-next { flex-direction: row-reverse; text-align: right; }
  @media (max-width: 520px) { .lesson-pagination { grid-template-columns: 1fr; gap: .7rem; } }
</style>
