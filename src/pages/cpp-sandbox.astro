---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteUrl } from '../lib/site-url';
const example = `#include <iostream>
using namespace std;

int main() {
    int berries = 0;
    cout << "請輸入找到的莓果數量：" << endl;
    cin >> berries;

    if (berries >= 3) {
        cout << "莓果收集完成，繼續出發！" << endl;
    } else {
        cout << "再找一些莓果吧！" << endl;
    }

    return 0;
}`;
---

<SiteLayout title="C++ 程式沙盒" description="和倉鼠一起接收資料，看看箱子裡的數值怎麼變化。">
  <section class="sandbox" data-cpp-sandbox data-worker={siteUrl('/cpp-compiler/check-worker.js')}>
    <header class="sandbox-heading">
      <p class="eyebrow">互動工具 · 第一版</p>
      <h1>C++ 程式沙盒</h1>
      <p>和倉鼠一起接氣球、搬資料，看程式在變數背包裡一步步運作。</p>
    </header>
    <div class="sandbox-grid">
      <section class="sandbox-card editor-panel" aria-label="程式與輸入">
        <div class="toolbar">
          <button class="primary" id="sandbox-start" type="button">模擬</button>
          <button id="sandbox-edit" type="button" hidden>回到編輯</button>
        </div>
        <label for="sandbox-code">C++ 程式碼</label>
        <div class="code-editor" id="sandbox-editor">
          <div class="code-overlay" aria-hidden="true"><pre id="sandbox-highlight"></pre></div>
          <textarea id="sandbox-code" rows="16" wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off">{example}</textarea>
        </div>
        <pre id="sandbox-reading" aria-label="目前執行的程式碼" tabindex="0" hidden></pre>
        <label for="sandbox-input">預先輸入</label>
        <textarea id="sandbox-input" rows="2" spellcheck="false" placeholder="可輸入多筆資料或整行文字">{'3\n'}</textarea>
        <p class="fine">用空格或換行分隔。預先輸入用完後，會跳出輸入視窗。</p>
      </section>

      <section class="sandbox-card field-panel" aria-label="沙盒場地">
        <div class="field-heading">
          <h2>莓果田冒險</h2>
          <span class="types"><span><i class="type-short"></i> short</span><span><i class="type-int"></i> int</span><span><i class="type-long"></i> long</span><span><i class="type-long-long"></i> long long</span><span><i class="type-bool"></i> bool</span><span><i class="type-char"></i> char</span><span><i class="type-float"></i> float</span><span><i class="type-double"></i> double</span><span><i class="type-string"></i> string</span></span>
        </div>
        <div class="toolbar play-controls" id="sandbox-play-controls" hidden>
          <button id="sandbox-back" type="button" disabled>上一步</button>
          <button id="sandbox-next" type="button" disabled>下一步</button>
          <button id="sandbox-play" type="button" disabled>播放</button>
          <label for="sandbox-speed">速度</label>
          <select id="sandbox-speed"><option value="1050">慢</option><option value="650" selected>正常</option><option value="300">快</option></select>
          <span id="sandbox-step">第 0 步</span>
        </div>
        <div class="field" id="sandbox-field">
          <div class="world-markers">
            <div class="supply">
              <div class="input-preview" id="sandbox-input-preview" aria-label="下一行預先輸入"></div>
              <div class="world-sign"><span aria-hidden="true">↓</span>補給站</div>
            </div>
            <button class="primary start-adventure" id="sandbox-enter-map" type="button" hidden>開始冒險</button>
          </div>
          <div class="road-world" id="sandbox-road-world" hidden aria-label="倉鼠冒險地圖">
            <div class="road-viewport" id="sandbox-road-viewport" tabindex="0" aria-label="倉鼠行走的地圖">
              <div class="road-map" id="sandbox-road-map"></div>
            </div>
          </div>
          <div class="backpack" id="sandbox-backpack" data-open="false">
            <div class="backpack-sign"><span aria-hidden="true">🎒</span> 變數背包</div>
            <div id="sandbox-pack-tabs" class="pack-tabs" role="tablist" aria-label="依型態查看變數"></div>
            <div id="sandbox-boxes" class="boxes" aria-label="背包裡的變數"></div>
            <div class="pack-pages">
              <button id="sandbox-pack-prev" type="button" aria-label="上一頁變數">←</button>
              <span id="sandbox-pack-page">第 1 頁</span>
              <button id="sandbox-pack-next" type="button" aria-label="下一頁變數">→</button>
            </div>
            <div id="sandbox-belt" class="conveyor" aria-label="背包輸送帶"><span id="sandbox-door">背包取物口</span></div>
          </div>
          <div id="sandbox-belt-spur" class="conveyor-spur" aria-hidden="true" hidden></div>
          <section id="sandbox-bitwork" class="bitwork" role="dialog" aria-label="位元運算過程" hidden>
            <h3 id="sandbox-bit-title">位元運算</h3>
            <div class="bit-row"><strong id="sandbox-bit-left-label">左值</strong><div id="sandbox-bit-left" class="bit-cells"></div></div>
            <div class="bit-row" id="sandbox-bit-right-row"><strong id="sandbox-bit-right-label">右值</strong><div id="sandbox-bit-right" class="bit-cells"></div></div>
            <div class="bit-row result"><strong id="sandbox-bit-result-label">結果</strong><div id="sandbox-bit-result" class="bit-cells"></div></div>
            <p class="bit-decimal" id="sandbox-bit-decimal"></p>
          </section>
          <div id="sandbox-explorer" class="explorer" aria-hidden="true">
            <svg class="explorer-sprite" viewBox="0 0 88 84">
              <ellipse cx="44" cy="76" rx="29" ry="5" fill="#6e815c" opacity=".28"/>
              <ellipse cx="31" cy="70" rx="11" ry="6" fill="#ecad78" stroke="#9e674c" stroke-width="2"/>
              <ellipse cx="57" cy="70" rx="11" ry="6" fill="#ecad78" stroke="#9e674c" stroke-width="2"/>
              <path d="M15 52c0-12 9-23 29-23s29 11 29 23c0 15-9 20-29 20s-29-5-29-20Z" fill="#e6a777" stroke="#9e674c" stroke-width="2.5"/>
              <circle cx="23" cy="19" r="12" fill="#d99565" stroke="#9e674c" stroke-width="2.5"/>
              <circle cx="65" cy="19" r="12" fill="#d99565" stroke="#9e674c" stroke-width="2.5"/>
              <circle cx="23" cy="19" r="6.5" fill="#f2a3a1"/><circle cx="65" cy="19" r="6.5" fill="#f2a3a1"/>
              <path d="M10 42c0-16 11-27 34-27s34 11 34 27c0 13-13 20-34 20S10 55 10 42Z" fill="#f0b47f" stroke="#9e674c" stroke-width="2.5"/>
              <path d="M15 44c3-10 14-14 23-9 4 2 8 2 12 0 9-5 20-1 23 9 3 10-10 16-29 16S12 54 15 44Z" fill="#fff0d5"/>
              <ellipse cx="31" cy="34" rx="4" ry="5" fill="#53372e"/><ellipse cx="57" cy="34" rx="4" ry="5" fill="#53372e"/>
              <circle cx="32" cy="32" r="1.2" fill="white"/><circle cx="58" cy="32" r="1.2" fill="white"/>
              <ellipse cx="21" cy="45" rx="5" ry="3" fill="#f3a39b"/><ellipse cx="67" cy="45" rx="5" ry="3" fill="#f3a39b"/>
              <path d="M39 40q5-3 10 0-1 5-5 5t-5-5Z" fill="#ad6057"/>
              <path d="M44 45v3m0 0q-4 6-9 1m9-1q4 6 9 1m-33-8-6-2m6 7-6 1m54-6 6-2m-6 7 6 1" fill="none" stroke="#9e674c" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M28 61q16 7 32 0l-4 7q-12 4-24 0z" fill="#77ac91" stroke="#507b68" stroke-width="1.8"/>
              <circle cx="45" cy="67" r="3" fill="#fff2ac"/>
              <g class="hamster-paws" fill="#ffdfb4" stroke="#b17c57" stroke-width="1.7">
                <ellipse cx="24" cy="61" rx="6" ry="5"/><ellipse cx="64" cy="61" rx="6" ry="5"/>
              </g>
            </svg>
            <div id="sandbox-bubble" class="speech" hidden></div>
            <div id="sandbox-thought" class="speech thought" hidden>
              <span id="sandbox-thought-expression"></span><strong id="sandbox-thought-result"></strong>
            </div>
          </div>
          <div id="sandbox-cargo" class="cargo" aria-hidden="true" hidden></div>
          <div id="sandbox-parcel" class="cargo parcel" aria-hidden="true" hidden></div>
          <template id="sandbox-cube">
            <svg class="cube" viewBox="0 0 70 63">
              <ellipse cx="37" cy="55" rx="25" ry="5" fill="#263d29" opacity=".19"/>
              <path class="cube-front" d="M8 22 37 32 37 58 8 47Z"/>
              <path class="cube-side" d="M37 32 63 20 63 46 37 58Z"/>
              <g class="cube-lid"><path class="cube-top" d="M8 22 34 6 63 20 37 32Z"/><text class="cube-value" x="35" y="22" text-anchor="middle"></text></g>
              <path d="m18 32 8 3v7l-8-3z" fill="#fff8d9" stroke="#70553a" stroke-width="1.3" stroke-linejoin="round"/>
            </svg>
          </template>
          <template id="sandbox-balloon">
            <div class="airmail">
              <svg viewBox="0 0 36 59" aria-hidden="true">
                <path d="M18 28q-7 13 0 27" fill="none" stroke="#9d645f" stroke-width="1.7"/>
                <path d="M18 29c-8-4-14-11-14-18a14 14 0 0 1 28 0c0 7-6 14-14 18Z" fill="#f49b9c" stroke="#b96874" stroke-width="1.7"/>
                <path d="M10 12q0-7 6-9" stroke="#ffe2e3" stroke-width="2.3" fill="none" stroke-linecap="round"/>
              </svg>
              <span class="input-token"></span>
            </div>
          </template>
        </div>
        <p id="sandbox-status" role="status">按「模擬」，看看倉鼠如何收送資料。</p>
        <a id="sandbox-debug" href={siteUrl('/cpp-debug/')} hidden>帶著程式碼去 Debug 工具</a>
        <h3>輸出紀錄</h3>
        <pre id="sandbox-output"></pre>
      </section>
    </div>
    <dialog id="sandbox-dialog" aria-labelledby="sandbox-dialog-title">
      <form id="sandbox-input-form">
        <h2 id="sandbox-dialog-title">補給站</h2>
        <label for="sandbox-token" id="sandbox-prompt">輸入一筆資料</label>
        <input id="sandbox-token" inputmode="text" autocomplete="off" />
        <p id="sandbox-input-error" role="alert" hidden>請輸入 int 範圍內的一筆整數。</p>
        <div class="toolbar">
          <button id="sandbox-cancel-input" type="button">稍後輸入</button>
          <button class="primary" type="submit">送出資料</button>
        </div>
      </form>
    </dialog>
  </section>
</SiteLayout>

<script>
  import '../scripts/cpp-sandbox';
</script>

<style>
  .sandbox { max-width: 85rem; margin: auto; }
  .sandbox-heading { margin-bottom: 1.1rem; }
  .sandbox-heading h1, .sandbox-heading p { margin-block: .3rem; }
  .sandbox-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 1rem; align-items: start; }
  .sandbox-card { min-width: 0; border: 1px solid #c1d2c1; padding: 1rem; border-radius: 1rem; background: #fff; }
  .road-world { grid-column: 1; grid-row: 2; min-width: 0; align-self: stretch; }
  .road-viewport { position: relative; max-height: 23rem; min-height: 12rem; overflow: auto; padding: .5rem .15rem 1rem; scroll-behavior: auto; scrollbar-color: #78985b transparent; }
  .road-map { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; min-height: 10rem; padding: .6rem .15rem 1.1rem; }
  :global(.road-sequence) { display: flex; flex-direction: column; align-items: center; width: 100%; }
  :global(.road-step) { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; min-width: 3.5rem; }
  :global(.road-cell) { position: relative; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border: 2px solid #766f5d; border-radius: .5rem; background: #8bb968; box-shadow: 0 .16rem #61784d; font-size: 1.35rem; transition: filter .2s,box-shadow .2s; }
  :global(.road-cell::after) { content: ''; position: absolute; inset: .22rem; border: 1px dashed #e3dcc0a8; border-radius: .32rem; pointer-events: none; }
  :global(.road-cell[data-kind="path"],.road-cell[data-kind="branch"],.road-cell[data-kind="loop"]) { width: 3.6rem; height: .9rem; border: 0; border-radius: 0; color: #fff2d3; background: repeating-linear-gradient(0deg,#956c48 0 .34rem,#a77b52 .34rem .68rem); box-shadow: none; }
  :global(.road-cell[data-kind="branch"]) { background: #9b7049; }
  :global(.road-cell[data-kind="loop"]) { color: #fff2d3; }
  :global(.road-cell[data-kind="path"]::after,.road-cell[data-kind="branch"]::after,.road-cell[data-kind="loop"]::after) { display: none; }
  :global(.road-label) { max-width: 8rem; margin-top: .12rem; padding: .12rem .34rem; border: 1px solid #957a4c; border-radius: .18rem .18rem .35rem .35rem; color: #443c2b; background: linear-gradient(#fff3cf,#ead49b); box-shadow: 0 .12rem #8c7144; font-size: .65rem; line-height: 1.25; text-align: center; overflow-wrap: anywhere; }
  .road-line { color: #53614a; font: .58rem/1.2 ui-monospace,monospace; }
  :global(.road-sign) { max-width: 95%; margin: .25rem 0 .35rem; padding: .2rem .42rem; border: 1px solid #977e42; border-radius: .4rem; color: #483d23; background: #fff1b5; font: 700 .68rem/1.35 ui-monospace,monospace; text-align: center; overflow-wrap: anywhere; }
  :global(.road-link) { position: relative; z-index: 0; width: 3.6rem; height: .9rem; margin: 0; border-inline: 2px solid #76563b; background: repeating-linear-gradient(0deg,#956c48 0 .34rem,#a77b52 .34rem .68rem); }
  :global(.road-start .road-cell) { border-color: #477c4b; background: #78b568; }
  :global(.road-goal .road-cell) { display: grid; place-items: center; border-color: #9c773e; background: #f5da82; }
  :global(.goal-icon) { width: 2.5rem; height: 2.5rem; }
  :global(.road-node.is-active > .road-step .road-cell) { z-index: 3; filter: brightness(1.18); box-shadow: 0 0 0 4px #fff2a3,0 0 0 7px #d38e36; }
  :global(.road-fork) { position: relative; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: .8rem; width: 100%; padding-top: 1.15rem; }
  :global(.road-fork::before) { content: ''; position: absolute; z-index: 0; top: 0; left: 24%; right: 24%; height: 1.2rem; border-radius: 999px; background: repeating-linear-gradient(90deg,#956c48 0 .45rem,#a77b52 .45rem .9rem); box-shadow: inset 0 0 0 2px #76563b; }
  :global(.road-fork::after) { content: ''; position: absolute; z-index: 0; top: -.65rem; left: calc(50% - 1.8rem); width: 3.6rem; height: 1.85rem; background: repeating-linear-gradient(0deg,#956c48 0 .34rem,#a77b52 .34rem .68rem); box-shadow: inset 2px 0 #76563b,inset -2px 0 #76563b; }
  :global(.road-lane) { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; min-width: 0; min-height: 6rem; width: 72%; justify-self: center; padding: .55rem .28rem 1.1rem; border-inline: 3px solid #76563b; background: repeating-linear-gradient(0deg,#956c48 0 1.3rem,#a77b52 1.3rem 2.6rem); }
  :global(.road-lane::before) { content: ''; position: absolute; top: -1.2rem; left: -3px; right: -3px; height: 1.3rem; background: #9c714d; }
  :global(.road-lane::after) { content: ''; position: absolute; z-index: 2; bottom: -1.2rem; left: calc(50% - 1.8rem); height: 1.3rem; width: 3.6rem; background: repeating-linear-gradient(0deg,#956c48 0 .34rem,#a77b52 .34rem .68rem); box-shadow: inset 2px 0 #76563b,inset -2px 0 #76563b; }
  :global(.road-lane-label) { position: relative; z-index: 1; max-width: 100%; margin: .35rem 0 .65rem; padding: .1rem .12rem; color: #fff2d3; background: transparent; font: 800 .72rem/1.3 ui-monospace,monospace; text-align: center; overflow-wrap: anywhere; text-shadow: 0 1px 1px #563b27; -webkit-text-stroke: .25px #563b27; }
  :global(.road-lane.is-chosen) { filter: brightness(1.12); box-shadow: inset 0 0 0 3px #f6d879; }
  :global(.road-lane > .road-sequence) { position: relative; z-index: 1; min-height: 2rem; width: 100%; }
  :global(.road-merge) { position: relative; align-self: stretch; width: 100%; height: 1.1rem; margin-top: .6rem; padding: 0; background: linear-gradient(90deg,transparent calc(50% - 1.8rem),#956c48 calc(50% - 1.8rem),#a77b52 calc(50% - 1.35rem),#956c48 calc(50% - .9rem),#a77b52 calc(50% - .45rem),#956c48 50%,#a77b52 calc(50% + .45rem),#956c48 calc(50% + .9rem),#a77b52 calc(50% + 1.35rem),#956c48 calc(50% + 1.8rem),transparent calc(50% + 1.8rem)); font-size: 0; }
  :global(.road-merge::before) { content: ''; position: absolute; top: .1rem; left: 24%; width: 52%; height: .9rem; border-radius: 999px; background: repeating-linear-gradient(90deg,#956c48 0 .45rem,#a77b52 .45rem .9rem); box-shadow: inset 0 0 0 2px #76563b; }
  :global(.road-loop) { position: relative; width: min(100%,19rem); margin: .4rem 0; padding: .55rem .35rem .65rem; border: 1.1rem solid #956c48; border-right-style: dashed; border-radius: 1.4rem 3.4rem 1.4rem 1.4rem; background: repeating-linear-gradient(0deg,#956c48 0 1.3rem,#a77b52 1.3rem 2.6rem); box-shadow: inset 0 0 0 2px #76563b; }
  :global(.road-loop .road-sign) { display: block; margin: .1rem auto .55rem; border: 0; padding: .15rem; color: #fff2d3; background: transparent; text-shadow: 0 1px 1px #563b27; }
  :global(.road-loop::after) { content: '↶'; position: absolute; top: -.85rem; right: -.75rem; color: #fff2d3; font-size: 1.25rem; }
  .road-hamster { position: absolute; z-index: 5; left: 50%; bottom: calc(100% - .35rem); width: 3.15rem; height: auto; pointer-events: none; transform: translateX(-50%); filter: drop-shadow(0 .15rem .12rem #475b3f66); }
  .start-adventure { align-self: center; margin-inline-start: auto; white-space: nowrap; }
  .toolbar { display: flex; flex-wrap: wrap; gap: .45rem; align-items: center; }
  .editor-panel label { display: block; font-weight: 700; margin: .8rem 0 .25rem; }
  button, select, input { font: inherit; color: #24483a; border: 1px solid #83a28b; border-radius: .5rem; background: #f6faf5; padding: .25rem .6rem; }
  button:not(:disabled) { cursor: pointer; }
  button:disabled { opacity: .45; }
  .primary { color: white; background: #235c45; }
  textarea, #sandbox-reading, #sandbox-output { box-sizing: border-box; display: block; width: 100%; margin: 0; border: 1px solid #a4bcab; border-radius: .55rem; padding: .6rem; color: #203a2f; background: #f3f8f2; font: .9rem/1.55 ui-monospace, monospace; }
  textarea { resize: vertical; }
  .code-editor { position: relative; }
  .code-overlay { position: absolute; inset: 1px; overflow: hidden; border-radius: .5rem; pointer-events: none; visibility: hidden; }
  .code-editor.has-highlight .code-overlay { visibility: visible; }
  .code-overlay pre { margin: 0; padding: .6rem; white-space: pre; font: .9rem/1.55 ui-monospace, monospace; }
  #sandbox-code { position: relative; white-space: pre; }
  .code-editor.has-highlight #sandbox-code { color: transparent; caret-color: #203a2f; background: transparent; }
  .code-editor.has-highlight #sandbox-code::selection { color: transparent; background: #588ac654; }
  .editor-panel :global(.token.keyword), .editor-panel :global(.token.directive) { color: #783b94; }
  .editor-panel :global(.token.string), .editor-panel :global(.token.char) { color: #1b663f; }
  .editor-panel :global(.token.number), .editor-panel :global(.token.boolean) { color: #9a471d; }
  .editor-panel :global(.token.comment) { color: #52665b; }
  .editor-panel :global(.token.function), .editor-panel :global(.token.class-name) { color: #215b98; }
  .editor-panel :global(.token.operator) { color: #923443; }
  @media (forced-colors: active) {
    .code-editor.has-highlight .code-overlay { visibility: hidden; }
    .code-editor.has-highlight #sandbox-code { color: FieldText; caret-color: auto; }
    .code-editor.has-highlight #sandbox-code::selection { color: HighlightText; background: Highlight; }
  }
  #sandbox-reading { height: 22.5rem; overflow: auto; white-space: pre; }
  #sandbox-reading :global(mark) { color: #182c24; background: #ffe19a; }
  .fine { color: #506659; font-size: .85rem; margin: .45rem 0; }
  .field-heading { display: flex; justify-content: space-between; gap: .6rem; align-items: center; margin-bottom: .55rem; }
  .field-heading h2, .field-panel h3 { margin: 0; }
  .field-heading span { font-size: .85rem; }
  .types { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0 .4rem; }
  .types span { white-space: nowrap; }
  .field-heading i { display: inline-block; width: .75em; height: .75em; border-radius: .2em; margin-inline: .22em; background: var(--box-color); }
  .field { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(14rem, 1fr); grid-template-rows: auto 1fr; align-items: start; min-height: 25rem; padding: .85rem; overflow: hidden; border: 2px solid #a8c996; border-radius: 1rem; background-color: #c9e49c; background-image: radial-gradient(ellipse at 25% 15%,#f1f7cfaa,transparent 55%),radial-gradient(#8ab86a 1px,transparent 1px),radial-gradient(#e2f0bd 1px,transparent 1px); background-size: auto,19px 19px,29px 29px; background-position: center,0 0,9px 14px; }
  .world-markers { grid-column: 1; grid-row: 1; display: flex; justify-content: center; padding: .2rem .45rem 1.35rem; }
  .supply { width: min(17rem, 100%); text-align: center; }
  .supply .world-sign { display: inline-block; }
  .input-preview { position: relative; min-width: 0; height: 1.8rem; overflow: hidden; margin-bottom: .3rem; border: 1px solid #a4bf90; border-radius: .6rem; background: #fffdf2; color: #4c6145; font: bold .86rem/1.8rem ui-monospace, monospace; }
