---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { courseFolderId, visibleCourses } from '../../lib/visibility';
import { siteUrl } from '../../lib/site-url';

const courses = visibleCourses(await getCollection('courseSettings'));
---

<SiteLayout title="所有課程">
  <section class="article">
    <p class="eyebrow">學習空間</p>
    <h1>所有課程</h1>
    {courses.length ? <ul class="course-cards">{courses.map((course) => <li><a href={siteUrl(`/courses/${courseFolderId(course.id)}/`)}><strong>{course.data.title}</strong><br /><span>開啟課程</span></a></li>)}</ul> : <p>目前還沒有課程。請依照 README 的步驟新增課程設定檔。</p>}
  </section>
</SiteLayout>
